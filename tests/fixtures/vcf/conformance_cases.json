{
  "suite_id": "siraloom-vcf-native-conformance-v1",
  "normative_source": "https://github.com/samtools/hts-specs",
  "normative_documents": {
    "VCFv4.1": "https://samtools.github.io/hts-specs/VCFv4.1.pdf",
    "VCFv4.2": "https://samtools.github.io/hts-specs/VCFv4.2.pdf",
    "VCFv4.3": "https://samtools.github.io/hts-specs/VCFv4.3.pdf",
    "VCFv4.4": "https://samtools.github.io/hts-specs/VCFv4.4.pdf",
    "VCFv4.5": "https://samtools.github.io/hts-specs/VCFv4.5.pdf"
  },
  "legacy_compatibility_note": "VCFv4.0 is retained as a parser compatibility smoke profile; the current HTS specifications index lists VCFv4.1 through VCFv4.5 as normative documents.",
  "versions": {
    "VCFv4.1": [
      {
        "id": "minimal_snp_valid",
        "category": "record+header",
        "expected": "PASS",
        "spec_basis": "Fixed fields, header and data-line syntax",
        "lines": [
          "##fileformat=VCFv4.1",
          "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO",
          "1\t2\t.\tA\tC\t.\tPASS\t."
        ]
      },
      {
        "id": "multiallelic_genotype_valid",
        "category": "genotype+cardinality",
        "expected": "PASS",
        "spec_basis": "GT allele indexes and Number=G cardinality",
        "lines": [
          "##fileformat=VCFv4.1",
          "##FORMAT=<ID=GT,Number=1,Type=String,Description=\"Genotype\">",
          "##FORMAT=<ID=PL,Number=G,Type=Integer,Description=\"Genotype likelihoods\">",
          "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tSAMPLE1",
          "1\t2\t.\tA\tC,G\t.\tPASS\t.\tGT:PL\t1/2:0,1,2,3,4,5"
        ]
      },
      {
        "id": "symbolic_deletion_valid",
        "category": "symbolic_allele",
        "expected": "PASS",
        "spec_basis": "Symbolic structural allele with declared reference span",
        "lines": [
          "##fileformat=VCFv4.1",
          "##INFO=<ID=SVTYPE,Number=1,Type=String,Description=\"Structural variant type\">",
          "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO",
          "1\t5\t.\tA\t<DEL>\t.\tPASS\tSVTYPE=DEL;END=9"
        ]
      },
      {
        "id": "duplicate_header_identifier_invalid",
        "category": "header",
        "expected": "VCF_HEADER_DEFINITION_INVALID",
        "spec_basis": "Structured header identifiers are unique within a definition type",
        "lines": [
          "##fileformat=VCFv4.1",
          "##FILTER=<ID=LowQual,Description=\"low quality\">",
          "##FILTER=<ID=LowQual,Description=\"duplicate identifier\">",
          "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO",
          "1\t2\t.\tA\tC\t.\tPASS\t."
        ]
      },
      {
        "id": "out_of_range_genotype_allele_invalid",
        "category": "genotype",
        "expected": "VCF_GENOTYPE_INVALID",
        "spec_basis": "GT allele indexes must identify REF or a declared ALT",
        "lines": [
          "##fileformat=VCFv4.1",
          "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tSAMPLE1",
          "1\t2\t.\tA\tC\t.\tPASS\t.\tGT\t2/2"
        ]
      },
      {
        "id": "symbolic_deletion_missing_span_invalid",
        "category": "symbolic_allele",
        "expected": "VCF_SV_SPAN_MISSING",
        "spec_basis": "Symbolic structural alleles require a resolvable span",
        "lines": [
          "##fileformat=VCFv4.1",
          "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO",
          "1\t5\t.\tA\t<DEL>\t.\tPASS\tSVTYPE=DEL"
        ]
      }
    ],
