{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SayedaRehmat/SIRALOOM/blob/main/docs/scientific/vcf-conformance/atomic-requirement-ledger.schema.json",
  "title": "SIRALOOM VCF Atomic Requirement Ledger",
  "description": "Schema for reviewed, version-aware, source-traceable VCF specification requirements. A record is not a conformance claim merely because it exists in this registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_status",
    "source_manifest",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "siraloom-vcf-atomic-requirements"
    },
    "registry_status": {
      "enum": [
        "SCHEMA_DEFINED_NO_CLAUSE_COMPLETENESS_CLAIM",
        "IN_PROGRESS",
        "REVIEWED_PARTIAL",
        "COMPLETE_PENDING_EXECUTION",
        "CONFORMANCE_EVIDENCE_COMPLETE"
      ]
    },
    "source_manifest": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_documents_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_lines_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "atomic_requirements_created": {
          "type": "integer",
          "minimum": 0
        },
        "atomic_requirements_independently_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "requirements_with_code_mapping": {
          "type": "integer",
          "minimum": 0
        },
        "requirements_with_executed_tests": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_source_questions": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "version",
        "source_class",
        "source_uri",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "enum": [
            "VCFv4.0",
            "VCFv4.1",
            "VCFv4.2",
            "VCFv4.3",
            "VCFv4.4",
            "VCFv4.5"
          ]
        },
        "source_class": {
          "enum": [
            "VCF_NORMATIVE_SOURCE",
            "VCF_INFORMATIVE_SOURCE",
            "PRODUCER_CONVENTION_SOURCE",
            "EXTERNAL_STANDARD_SOURCE",
            "SIRALOOM_POLICY_SOURCE"
          ]
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_blob_sha1": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator_type",
            "locator_value"
          ],
          "properties": {
            "locator_type": {
              "enum": [
                "SECTION",
                "SUBSECTION",
                "PARAGRAPH",
                "TABLE",
                "TABLE_ROW",
                "GRAMMAR_PRODUCTION",
                "FOOTNOTE",
                "EXAMPLE",
                "PAGE",
                "LINE_RANGE",
                "ANCHOR",
                "OTHER"
              ]
            },
            "locator_value": {
              "type": "string",
              "minLength": 1
            },
            "start_line": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "end_line": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "source_excerpt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "versionApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "CHANGED",
            "UNRESOLVED",
            "SOURCE_NOT_PINNED"
          ]
        },
        "source_reference_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "delta_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "test_kind",
        "execution_status"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "test_kind": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "BOUNDARY",
            "PROPERTY",
            "FUZZ",
            "DIFFERENTIAL",
            "REAL_PRODUCER",
            "TRANSFORMATION_PRESERVATION",
            "OTHER"
          ]
        },
        "execution_status": {
          "enum": [
            "NOT_CREATED",
            "NOT_RUN",
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "expected_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{40})?$"
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "evidence_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "title",
        "requirement_domain",
        "source_class",
        "requirement_kind",
        "normative_force",
        "atomic_statement",
        "actor",
        "condition",
        "observable_acceptance_condition",
        "source_references",
        "version_applicability",
        "implementation",
        "tests",
        "review"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^VCF-REQ-[0-9]{6}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requirement_domain": {
          "enum": [
            "FILE_STRUCTURE",
            "ENCODING",
            "HEADER",
            "FIXED_FIELDS",
            "INFO",
            "FORMAT",
            "GENOTYPE",
            "ALLELE_REPRESENTATION",
            "REFERENCE",
            "STRUCTURAL_VARIANT",
            "BREAKEND",
            "GVCF",
            "SAMPLE_PEDIGREE",
            "ORDERING",
            "MISSINGNESS",
            "INTEROPERABILITY",
            "OTHER"
          ]
        },
        "source_class": {
          "enum": [
            "VCF_NORMATIVE",
            "VCF_INFORMATIVE",
            "PRODUCER_CONVENTION",
            "EXTERNAL_STANDARD",
            "SIRALOOM_POLICY"
          ]
        },
        "requirement_kind": {
          "enum": [
            "PROSE_RULE",
            "GRAMMAR_RULE",
            "TABLE_CONSTRAINT",
            "FIELD_DEFINITION",
            "FOOTNOTE_RULE",
            "EXAMPLE_DERIVED_CONSTRAINT",
            "CROSS_REFERENCE_RULE",
            "CHANGE_LOG_DISCOVERY_ONLY"
          ]
        },
        "normative_force": {
          "enum": [
            "MUST",
            "MUST_NOT",
            "SHALL",
            "SHALL_NOT",
            "SHOULD",
            "SHOULD_NOT",
            "MAY",
            "MAY_NOT",
            "REQUIRED",
            "RECOMMENDED",
            "OPTIONAL",
            "DESCRIPTIVE",
            "NOT_STATED"
          ]
        },
        "atomic_statement": {
          "type": "string",
          "minLength": 1,
          "description": "Concise paraphrase of exactly one independently verifiable obligation, prohibition, permission, or recommendation; do not reproduce long source passages."
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "required_or_prohibited_behavior": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observable_acceptance_condition": {
          "type": "string",
          "minLength": 1
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "version_applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "VCFv4.0",
            "VCFv4.1",
            "VCFv4.2",
            "VCFv4.3",
            "VCFv4.4",
            "VCFv4.5"
          ],
          "properties": {
            "VCFv4.0": {
              "$ref": "#/$defs/versionApplicability"
            },
            "VCFv4.1": {
              "$ref": "#/$defs/versionApplicability"
            },
            "VCFv4.2": {
              "$ref": "#/$defs/versionApplicability"
            },
            "VCFv4.3": {
              "$ref": "#/$defs/versionApplicability"
            },
            "VCFv4.4": {
              "$ref": "#/$defs/versionApplicability"
            },
            "VCFv4.5": {
              "$ref": "#/$defs/versionApplicability"
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "code_symbols"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_AUDITED",
                "IMPLEMENTED",
                "PARTIAL",
                "MISSING",
                "UNSUPPORTED",
                "NOT_APPLICABLE",
                "BLOCKED",
                "CONFLICTING_EVIDENCE"
              ]
            },
            "code_symbols": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "implementation_commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([0-9a-f]{40})?$"
            },
            "owner_workstream": {
              "type": [
                "string",
                "null"
              ]
            },
            "rationale": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testEvidence"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "review_rationale"
          ],
          "properties": {
            "status": {
              "enum": [
                "UNREVIEWED",
                "IN_REVIEW",
                "REVIEWED",
                "REJECTED",
                "DISPUTED",
                "NEEDS_SOURCE_CLARIFICATION"
              ]
            },
            "review_rationale": {
              "type": "string"
            },
            "reviewer_role": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewer_reference": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_at_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "independent_second_review_required": {
              "type": "boolean"
            },
            "second_review_status": {
              "enum": [
                "NOT_STARTED",
                "IN_REVIEW",
                "AGREED",
                "DISAGREED",
                "NOT_REQUIRED"
              ]
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_kind",
              "status"
            ],
            "properties": {
              "evidence_kind": {
                "enum": [
                  "SOURCE_CAPTURE",
                  "TEST_RUN",
                  "DIFFERENTIAL_RUN",
                  "REAL_PRODUCER_FILE",
                  "TRANSFORMATION_RECONCILIATION",
                  "REVIEW_RECORD",
                  "LABORATORY_APPROVAL",
                  "OTHER"
                ]
              },
              "status": {
                "enum": [
                  "PLANNED",
                  "CAPTURED",
                  "VERIFIED",
                  "FAILED",
                  "BLOCKED",
                  "SUPERSEDED"
                ]
              },
              "artifact_uri": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "commit": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^([0-9a-f]{40})?$"
              },
              "tool_versions": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "related_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VCF-REQ-[0-9]{6}$"
          },
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
