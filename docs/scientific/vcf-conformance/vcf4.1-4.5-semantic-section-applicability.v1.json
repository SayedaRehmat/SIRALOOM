  "major_semantic_changes": [
    {
      "feature": "GLE reserved FORMAT field",
      "introduced": "VCFv4.1",
      "last_present": "VCFv4.2",
      "removed_in": "VCFv4.3",
      "evidence": [
        "VCFv4.1.tex:208",
        "VCFv4.2.tex:225",
        "VCFv4.3.tex:2168"
      ],
      "finding": "VCFv4.3 change log explicitly says the unused and ill-defined GLE FORMAT tag was removed; it is absent from VCFv4.3/4.4/4.5 reserved FORMAT inventories.",
      "status": "AUTHOR_CONFIRMED_REMOVAL_FROM_RESERVED_SET"
    },
    {
      "feature": "PSL/PSO/PSQ phase-set list fields",
      "introduced": "VCFv4.4",
      "retained_through": "VCFv4.5",
      "evidence": [
        "VCFv4.4.tex:496-498",
        "VCFv4.4.tex:598-635",
        "VCFv4.5.tex:594-596",
        "VCFv4.5.tex:771-809"
      ],
      "finding": "VCFv4.4 introduces Number=P and PSL/PSO/PSQ for allele-level phasing and derivative chromosome traversal; VCFv4.5 retains these semantics.",
      "status": "AUTHOR_CONFIRMED_ADDITION_AND_RETENTION"
    },
    {
      "feature": "Number=P",
      "introduced": "VCFv4.4",
      "retained_through": "VCFv4.5",
      "evidence": [
        "VCFv4.4.tex:2561",
        "VCFv4.5.tex:2731"
      ],
      "finding": "The change logs identify Number=P as added for fields with cardinality matching sample ploidy/local copy number; in VCFv4.5 it applies to per-GT-allele values, distinct from Number=G genotype combinations.",
      "status": "AUTHOR_CONFIRMED_ADDITION_AND_REFINEMENT"
    },
    {
      "feature": "SVLEN cardinality and meaning",
      "introduced": "VCFv4.4",
      "retained_through": "VCFv4.5",
      "evidence": [
        "VCFv4.1.tex:253",
        "VCFv4.2.tex:270",
        "VCFv4.3.tex:635",
        "VCFv4.4.tex:720-733",
        "VCFv4.5.tex:881-894"
      ],
      "finding": "Earlier versions use Number=. and describe the difference in length between REF and ALT. VCFv4.4 changes to Number=A and defines one length per ALT for symbolic SV classes; VCFv4.5 retains Number=A and specifies missing values for non-symbolic/breakend alleles plus compatibility inference from END.",
      "status": "AUTHOR_CONFIRMED_CARDINALITY_AND_SEMANTIC_REFINEMENT"
    },
    {
      "feature": "SVTYPE deprecation",
      "introduced": "VCFv4.4",
      "retained_through": "VCFv4.5",
      "evidence": [
        "VCFv4.4.tex:2583",
        "VCFv4.5.tex:871-877"
      ],
      "finding": "VCFv4.4 change log records SVTYPE deprecation; VCFv4.5 explicitly explains redundancy with ALT and directs readers to the symbolic ALT set. The change log is corroborative; the VCFv4.5 normative prose is the direct semantic anchor.",
      "status": "AUTHOR_CONFIRMED_DEPRECATION_WITH_4.5_EXPLICIT_RATIONALE"
    },
    {
      "feature": "Local allele fields and Number=LA/LR/LG",
      "introduced": "VCFv4.5",
      "evidence": [
        "VCFv4.5.tex:188-202",
        "VCFv4.5.tex:501-502",
        "VCFv4.5.tex:535-556",
        "VCFv4.5.tex:686-718"
      ],
      "finding": "Local-allele representation and LAA dependency are introduced in VCFv4.5; no corresponding fields were found in VCFv4.1-4.4 pinned sources.",
      "status": "AUTHOR_CONFIRMED_VERSION_INTRODUCTION"
    },
    {
      "feature": "Base modification M/DPM/ADM field families",
      "introduced": "VCFv4.5",
      "evidence": [
        "VCFv4.5.tex:199-218",
        "VCFv4.5.tex:556-588",
        "VCFv4.5.tex:720-758"
      ],
      "finding": "M/DPM/ADM base-modification field families, ChEBI-linked semantics, aliases and strand/missing/reference-block behavior appear in VCFv4.5; no corresponding fields were found in VCFv4.1-4.4 pinned sources.",
      "status": "AUTHOR_CONFIRMED_VERSION_INTRODUCTION_WITH_ALIAS_AMBIGUITY"
    },
    {
      "feature": "FORMAT LEN and sample-specific <*> blocks",
      "introduced": "VCFv4.5",
      "evidence": [
        "VCFv4.5.tex:539",
        "VCFv4.5.tex:606",
        "VCFv4.5.tex:1848-1860"
      ],
      "finding": "VCFv4.5 adds FORMAT LEN for sample-specific reference block lengths and backward compatibility with INFO END; the gVCF section also defines <NON_REF> as an alias of <*>.",
      "status": "AUTHOR_CONFIRMED_VERSION_INTRODUCTION"
    },
    {
      "feature": "END deprecation",
      "introduced": "VCFv4.5",
      "evidence": [
        "VCFv4.5.tex:471",
        "VCFv4.5.tex:485-493",
        "VCFv4.5.tex:867"
      ],
      "finding": "VCFv4.5 marks INFO END deprecated for backwards compatibility and defines computed END behavior from REF, SVLEN and FORMAT LEN contributions; it remains relevant to BCF rlen/indexing.",
      "status": "AUTHOR_CONFIRMED_VERSION_INTRODUCTION"
    },
    {
      "feature": "Character encoding section and escape mapping table",
      "introduced": "VCFv4.3",
      "retained_through": "VCFv4.5",
      "evidence": [
        "VCFv4.3.tex:75-95",
        "VCFv4.4.tex:75-95",
        "VCFv4.5.tex:73-93"
      ],
      "finding": "A dedicated UTF-8, BOM, prohibited control-character, line separator and uppercase percent-encoding section is present from VCFv4.3 onward; no equivalent dedicated section/table was found in VCFv4.1 or VCFv4.2.",
      "status": "AUTHOR_STRUCTURAL_DELTA_FOUND_NORMATIVE_EFFECT_REVIEW_PENDING"
    }
  ],
