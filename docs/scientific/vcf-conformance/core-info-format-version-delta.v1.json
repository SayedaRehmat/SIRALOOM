  "info_changes": [
    {
      "change": "VCFv4.1–4.2 list reserved INFO names and meanings in prose; VCFv4.3–4.5 use a Number/Type/Description table.",
      "versions": [
        "VCFv4.1",
        "VCFv4.2",
        "VCFv4.3",
        "VCFv4.4",
        "VCFv4.5"
      ],
      "interpretation": "The earlier prose list does not provide Number and Type columns; do not backfill those columns from later versions as if they were explicitly specified in 4.1/4.2."
    },
    {
      "change": "AD, ADF and ADR appear as additional reserved INFO keys in the VCFv4.3–4.5 tables and are not in the reviewed 4.1–4.2 core INFO lists.",
      "versions": [
        "VCFv4.3",
        "VCFv4.4",
        "VCFv4.5"
      ],
      "interpretation": "Version-specific reserved-key availability; verify the exact meta-information declaration rules and do not silently apply later reserved-key semantics to earlier versions."
    },
    {
      "change": "The END row changes its description in VCFv4.5 to 'Deprecated. Present for backwards compatibility with earlier versions of VCF.'",
      "versions": [
        "VCFv4.3",
        "VCFv4.4",
        "VCFv4.5"
      ],
      "interpretation": "VCFv4.5 also supplies a dedicated END explanation immediately after the table, including computed span semantics and indexing/BCF rlen rationale. This is a substantive semantic delta requiring a dedicated atomic requirement and regression tests."
    }
  ],
  "format_changes": [
    {
      "change": "VCFv4.1–4.2 enumerate 13 reserved FORMAT/genotype keys in prose, including GLE; VCFv4.3 table contains 16 rows and omits GLE while adding AD, ADF, ADR and PP.",
      "versions": [
        "VCFv4.1",
        "VCFv4.2",
        "VCFv4.3"
      ],
      "interpretation": "The 4.3 table is not a pure formatting conversion. GLE's absence and the new rows require explicit compatibility/delta decisions; do not infer GLE is invalid solely from omission without checking full normative scope."
    },
    {
      "change": "VCFv4.4 expands the core reserved FORMAT table from 16 to 19 rows with PSL, PSO and PSQ phase-set-list keys.",
      "versions": [
        "VCFv4.3",
        "VCFv4.4"
      ],
      "interpretation": "These fields have Number P and distinct phase-set-list semantics; they require dedicated parsing/cardinality and interoperability tests."
    },
    {
      "change": "VCFv4.5 expands the table to 63 rows, adding LEN, local-allele fields (LA/LAA/LAD/LADF/LADR/LEC/LGL/LGP/LPL/LPP), base-modification patterns and aliases.",
      "versions": [
        "VCFv4.4",
        "VCFv4.5"
      ],
      "interpretation": "The three parameterized base-modification key patterns are patterns, not literal key names; aliases map to ChEBI identifiers. The local-allele family requires dependencies and cardinality semantics from the surrounding prose, not table-only interpretation."
    }
  ],
