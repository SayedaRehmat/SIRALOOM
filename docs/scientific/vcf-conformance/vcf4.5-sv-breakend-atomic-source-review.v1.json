  "contextual_findings": [
    {
      "topic": "Per-allele missing-value model",
      "source_lines": [
        844,
        848
      ],
      "finding": "SV per-allele values cover every ALT including non-SV alleles; missing placeholders are used except string lists, where empty string is specified."
    },
    {
      "topic": "SVLEN/END",
      "source_lines": [
        867,
        896
      ],
      "finding": "END is deprecated; SVLEN is primary for symbolic SV length. Legacy inference from END and absolute-value treatment of negative SVLEN are explicit backward-compatibility semantics."
    },
    {
      "topic": "Confidence interval interactions",
      "source_lines": [
        900,
        926
      ],
      "finding": "CIPOS and CIEND have ALT-paired offsets and distinct coordinate anchors. CIPOS spans POS; CIEND is relative to END inferred from SVLEN. CIEND absence defaults to CIPOS; CIPOS has an exact default only when both IMPRECISE and CIPOS are absent."
    },
    {
      "topic": "Event vocabulary",
      "source_lines": [
        976,
        1001
      ],
      "finding": "EVENT groups records; EVENTTYPE classifies. The reserved event list is a SHOULD-use-when-appropriate vocabulary, while unlisted values are implementation-defined. EVENT is not restricted to SV."
    },
    {
      "topic": "SVCLAIM",
      "source_lines": [
        1024,
        1066
      ],
      "finding": "D/J/DJ encode abundance/adjacency/both and have ALT-class-dependent mandatory/optional domains. Scope is each ALT in isolation; do not infer one claim across a complex event."
    },
    {
      "topic": "Tandem-repeat cardinalities",
      "source_lines": [
        1070,
        1140
      ],
      "finding": "RN controls flattened list lengths and has missing/default rules; repeat arrays preserve ALT order; RUS/RUL/RUC/RB consistency is partly exact and partly approximate; CIRUC/CIRB intervals have explicit signs and missing-bound semantics; RUB requires RUC."
    },
    {
      "topic": "Breakend grammar and topology",
      "source_lines": [
        1394,
        1424
      ],
      "finding": "A novel adjacency has two mate breakends and two records. ALT replacement encodes replacement sequence, mate coordinate and orientation using four bracket forms; the orientation table is interpreted jointly with the prose definitions."
    },
    {
      "topic": "Mate/partner distinction",
      "source_lines": [
        1521,
        1560
      ],
      "finding": "Multiple mates become alternate alleles; PARID describes a partner relation distinct from MATEID's adjacency mate relation."
    },
    {
      "topic": "Uncertainty and single breakends",
      "source_lines": [
        1648,
        1706
      ],
      "finding": "Homology uncertainty uses leftmost placement plus CIPOS; mate coordinates are conditional under reciprocal uncertainty; single breakends lack mates."
    }
  ],
