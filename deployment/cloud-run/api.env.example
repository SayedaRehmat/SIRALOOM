APP_ENV=production
APP_NAME=SIRALOOM
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/siraloom
REDIS_URL=redis://REDIS_HOST:6379/0
PUBLIC_BASE_URL=https://API_HOST
FRONTEND_ORIGIN=https://FRONTEND_HOST
FIREBASE_AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID
# Leave unset on Cloud Run so Firebase Admin uses Application Default Credentials.
# FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_ENABLED=true
FIREBASE_STORAGE_BUCKET=FIREBASE_STORAGE_BUCKET
GENEBE_ENABLED=true
GENEBE_EMAIL=
GENEBE_API_KEY=
GNOMAD_ENABLED=true
REFERENCE_FASTA=/data/references/GRCh38.fa
REFERENCE_FAI=/data/references/GRCh38.fa.fai
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
PARTITION_SCHEDULER_CPU_CAPACITY=2
PARTITION_SCHEDULER_MEMORY_MB=4096
PARTITION_LEASE_SECONDS=900
PARTITION_MAX_ATTEMPTS=3
CELERY_WORKER_MAX_TASKS_PER_CHILD=20
CELERY_WORKER_PREFETCH_MULTIPLIER=1
