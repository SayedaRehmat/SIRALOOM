apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: siraloom-api
spec:
  template:
    metadata:
      annotations:
        run.googleapis.com/execution-environment: gen2
    spec:
      serviceAccountName: SIRALOOM_RUNTIME_SERVICE_ACCOUNT
      containers:
        - image: REGION-docker.pkg.dev/PROJECT_ID/siraloom/siraloom-backend:IMAGE_TAG
          ports:
            - containerPort: 8000
          env:
            - name: APP_ENV
              value: production
            - name: LOG_LEVEL
              value: INFO
            - name: DATABASE_URL
              value: "postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/siraloom"
            - name: REDIS_URL
              value: "redis://REDIS_HOST:6379/0"
            - name: PUBLIC_BASE_URL
              value: "https://API_HOST"
            - name: FRONTEND_ORIGIN
              value: "https://FRONTEND_HOST"
            - name: FIREBASE_AUTH_REQUIRED
              value: "true"
            - name: FIREBASE_PROJECT_ID
              value: FIREBASE_PROJECT_ID
            - name: FIREBASE_STORAGE_ENABLED
              value: "true"
            - name: FIREBASE_STORAGE_BUCKET
              value: FIREBASE_STORAGE_BUCKET
            - name: GENEBE_ENABLED
              value: "true"
            - name: GENEBE_EMAIL
              valueFrom:
                secretKeyRef:
                  name: genebe-email
                  key: latest
            - name: GENEBE_API_KEY
              valueFrom:
                secretKeyRef:
                  name: genebe-api-key
                  key: latest
            - name: GNOMAD_ENABLED
              value: "true"
            - name: REFERENCE_FASTA
              value: /data/references/GRCh38.fa
            - name: REFERENCE_FAI
              value: /data/references/GRCh38.fa.fai
            - name: PARTITION_SCHEDULER_CPU_CAPACITY
              value: "2"
            - name: PARTITION_SCHEDULER_MEMORY_MB
              value: "4096"
            - name: PARTITION_LEASE_SECONDS
              value: "900"
            - name: PARTITION_MAX_ATTEMPTS
              value: "3"
          resources:
            limits:
              cpu: "2"
              memory: 4Gi
          volumeMounts:
            - name: references
              mountPath: /data/references
      volumes:
        - name: references
          csi:
            driver: gcsfuse.run.googleapis.com
            readOnly: true
            volumeAttributes:
              bucketName: SIRALOOM_REFERENCE_BUCKET
