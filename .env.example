APP_NAME=SIRALOOM
APP_ENV=development
API_VERSION=v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://siraloom:siraloom@localhost:5432/siraloom
REDIS_URL=redis://localhost:6379/0

# Scientific execution profile; only registered SOFTWARE_QUALIFIED profiles may start.
BCFTOOLS_PROFILE_ID=bcftools-1.25-htslib-1.25-linux-64
BCFTOOLS_VERSION=1.25
HTSLIB_VERSION=1.25
BCFTOOLS_LOCK_FILE=configs/bioinformatics/profiles/bcftools-1.25-linux-64.lock
BCFTOOLS_PLATFORM=linux-64
# Trusted deployment-provided worker image digest. VEP profiles fail closed if absent/mismatched.
# This value must be supplied by the deployment/worker launcher and match the approved VEP profile.
SIRALOOM_RUNTIME_IMAGE_DIGEST=
ARTIFACT_ROOT=/data/siraloom/artifacts
ARTIFACT_STORAGE_TARGETS_JSON={}
# Hard API-level limit per artifact upload; increase only after sizing ingress and temporary disk.
MAX_ARTIFACT_UPLOAD_BYTES=536870912

GENEBE_ENABLED=false
GENEBE_EMAIL=
GENEBE_API_KEY=
GENEBE_BASE_URL=https://api.genebe.net/cloud/api-public/v1
GENEBE_TIMEOUT_SECONDS=60
GENEBE_MAX_BATCH=1000
GENEBE_RETRY_ATTEMPTS=3
GENEBE_RETRY_BACKOFF_SECONDS=2
GENEBE_RETRY_MAX_BACKOFF_SECONDS=30

PUBLIC_BASE_URL=http://localhost:8000

# Phase 1 scientific data path
GNOMAD_ENABLED=false
GNOMAD_GRAPHQL_ENDPOINT=https://gnomad.broadinstitute.org/api
GNOMAD_DATASET_ID=gnomad_r4
GNOMAD_GRAPHQL_DELAY_SECONDS=0
REFERENCE_FASTA=
REFERENCE_FAI=
GENEBE_GNOMAD_RESOURCE_VERSION=4.1-provider-aggregate

FRONTEND_ORIGIN=http://localhost:3000

# Firebase server configuration. Never put a service-account JSON value in this file.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_AUTH_REQUIRED=false
FIREBASE_STORAGE_ENABLED=false
FIREBASE_STORAGE_BUCKET=
# Set true in every production deployment. FastAPI then requires a Firebase Bearer token.

# Frontend public Firebase web configuration (identifiers, never Admin credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
