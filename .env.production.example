APP_ENV=production
APP_NAME=SIRALOOM
LOG_LEVEL=INFO
# Service runtime environment file; set an absolute isolated path for restore drills.
SIRALOOM_RUNTIME_ENV_FILE=.env
DATABASE_URL=postgresql+psycopg://siraloom:CHANGE_ME@postgres:5432/siraloom
# Generate with `openssl rand -hex 32`; production Compose requires Redis AUTH.
REDIS_PASSWORD=CHANGE_ME
ARTIFACT_ROOT=/data/siraloom/artifacts
# Optional deployment-owned target allowlist; see docs/DEPLOYMENT.md for lab isolation.
ARTIFACT_STORAGE_TARGETS_JSON={}
# Default is 512 MiB. Increase only after ingress, temp-disk and persistent-storage capacity tests.
MAX_ARTIFACT_UPLOAD_BYTES=536870912
RESOURCE_CACHE_ROOT=/data/siraloom/resource-cache
WORKER_SCRATCH_ROOT=/data/siraloom/scratch
STORAGE_CAPACITY_PREFLIGHT_ENABLED=true
ANALYSIS_ARTIFACT_OUTPUT_MULTIPLIER=1.0
ANALYSIS_SCRATCH_MULTIPLIER=2.0
ANALYSIS_STORAGE_HEADROOM_BYTES=1073741824
RESOURCE_STAGING_ALLOWED_HOSTS=
RESOURCE_STAGING_LOCAL_SOURCE_ROOTS=/data/references
RESOURCE_STAGING_MAX_BYTES=5368709120
RESOURCE_STAGING_TIMEOUT_SECONDS=30
PUBLIC_BASE_URL=https://lab.example.org
FRONTEND_ORIGIN=https://lab.example.org

# Production must use Firebase Admin verification. Do not commit credentials.
FIREBASE_AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase_admin_credentials
FIREBASE_ADMIN_CREDENTIALS_HOST_PATH=/etc/siraloom/secrets/firebase-admin.json
FIREBASE_STORAGE_ENABLED=false

# Public SaaS organization creation stays disabled in production.
ORGANIZATION_SELF_SIGNUP_ENABLED=false

# One-time first laboratory bootstrap. Set true only while provisioning a fresh
# laboratory deployment with zero organizations. After the first organization
# is created, this endpoint closes automatically; set it back to false as an
# operational safeguard. Subsequent users enter through invitations/membership.
ORGANIZATION_FIRST_BOOTSTRAP_ENABLED=false

# Research/development provider only. Keep disabled unless explicitly configured.
GENEBE_ENABLED=false
GENEBE_EMAIL=
GENEBE_API_KEY=
GNOMAD_ENABLED=false

# A validated reference is required for Phase 1 normalization.
REFERENCE_FASTA=/data/references/GRCh38.fa
REFERENCE_FAI=/data/references/GRCh38.fa.fai

# Production normalization must use the validated local reference package.
# Ensembl REST is not a production normalization dependency.
REFERENCE_REMOTE_ENABLED=false
REFERENCE_REMOTE_GRCH38_ENDPOINT=https://rest.ensembl.org
REFERENCE_REMOTE_GRCH37_ENDPOINT=https://grch37.rest.ensembl.org
REFERENCE_REMOTE_TIMEOUT_SECONDS=10
REFERENCE_REMOTE_WINDOW_FLANK=1000

CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

# Queue/resource hardening
PARTITION_SCHEDULER_CPU_CAPACITY=2
PARTITION_SCHEDULER_MEMORY_MB=4096
PARTITION_LEASE_SECONDS=900
PARTITION_MAX_ATTEMPTS=3
CELERY_WORKER_MAX_TASKS_PER_CHILD=20
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Host directories are bind-mounted into the stack so the lab controls retention, backup and capacity.
# Create these directories first and grant the matching container service user write access.
SIRALOOM_POSTGRES_HOST_PATH=/srv/siraloom/postgres
SIRALOOM_REDIS_HOST_PATH=/srv/siraloom/redis
SIRALOOM_ARTIFACT_HOST_PATH=/srv/siraloom/artifacts
# For per-organization local targets, set one host path per tenant and apply
# deployment/storage-targets-local.compose.example.yml. Its container targets
# must match each target's `root` in ARTIFACT_STORAGE_TARGETS_JSON.
# SIRALOOM_LAB_A_ARTIFACT_HOST_PATH=/srv/siraloom/labs/lab-a/artifacts
# SIRALOOM_LAB_B_ARTIFACT_HOST_PATH=/srv/siraloom/labs/lab-b/artifacts
SIRALOOM_REFERENCE_HOST_PATH=/srv/siraloom/references
SIRALOOM_RESOURCE_CACHE_HOST_PATH=/srv/siraloom/resource-cache
SIRALOOM_SCRATCH_HOST_PATH=/srv/siraloom/scratch
SIRALOOM_BEAT_HOST_PATH=/srv/siraloom/beat

# Public URL served by the lab reverse proxy; browser clients cannot resolve Docker service names.
NEXT_PUBLIC_SIRALOOM_API_BASE=https://lab.example.org/api/v1
NEXT_PUBLIC_SIRALOOM_DEPLOYMENT_MODE=lab
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id
